# Fill in only the selected provider's block. No real secrets.
SCRUM_PROVIDER=azure-devops
AZURE_DEVOPS_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_TEAM=your-team
# pat or access-token; only the selected credential is used.
AZURE_DEVOPS_AUTH_MODE=pat
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ACCESS_TOKEN=
AZURE_DEVOPS_API_VERSION=7.1

# Jira Cloud: SCRUM_PROVIDER=jira-cloud
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_PROJECT_KEY=APP
JIRA_BOARD_ID=
# Optional name for a new board (an existing ID takes precedence).
JIRA_BOARD_NAME=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Jira Data Center: SCRUM_PROVIDER=jira-dc
# JIRA_BASE_URL=https://jira.example.com/jira
JIRA_PAT=

# Git review API uses its own PAT, independently of tracker credentials.
# Supported adapters: github or azure-repos.
GIT_PROVIDER=github
GIT_API_URL=https://api.github.com
GIT_REPOSITORY=your-owner/your-repository
GIT_PROJECT=
GIT_PAT=
# For Azure Repos:
# GIT_PROVIDER=azure-repos
# GIT_API_URL=https://dev.azure.com/your-organization
# GIT_PROJECT=your-project
# GIT_REPOSITORY=your-repository-id
